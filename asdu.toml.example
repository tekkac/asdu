# Copy this file and edit it, then pass it with --config.
# Rules are checked in order. A session's first matching rule is its primary
# virtual folder; all matching tags are still visible in the session detail.

# Example project rule: replace the path and name with your own.
[[tag]]
name = "project: example"
paths = ["/path/to/your/project/"]
keywords = ["example project"]

[[tag]]
name = "research"
paths = ["/research/", "/papers/"]
keywords = ["literature review", "research question", "proof sketch"]

[[tag]]
name = "tooling"
keywords = ["mcp server", "agent skill", "plugin", "command line tool"]

[[tag]]
name = "operations"
keywords = ["deployment", "docker", "kubernetes", "terraform"]

[[tag]]
name = "data"
keywords = ["sql query", "data pipeline", "dataset", "jupyter notebook"]

[[tag]]
name = "documentation"
keywords = ["write documentation", "update readme", "release notes", "api reference"]
